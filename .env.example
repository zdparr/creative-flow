# Local development. Copy to .env and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storyforge
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-long-random-string
# The single author allowed to sign in (v1 is single-user).
AUTH_ALLOWED_EMAIL=you@example.com
# Public base URL used in magic links.
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5
MODEL_STRONG=claude-opus-5-5
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
