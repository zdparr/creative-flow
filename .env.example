# Local development. Copy to .env and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storyforge
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-long-random-string
# The single author's login (v1 is single-user). Password needs 12+ characters.
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_PASSWORD=change-me-please
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5
MODEL_STRONG=claude-opus-5-5
STRUCTURED_OUTPUTS=false
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
