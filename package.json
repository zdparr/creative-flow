{
  "name": "storyforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @storyforge/db generate",
    "db:migrate": "pnpm --filter @storyforge/db migrate",
    "eval:cohesion": "pnpm --filter @storyforge/core build && node packages/core/dist/evals/cohesion.js",
    "eval:prose": "pnpm --filter @storyforge/core build && node packages/core/dist/evals/prose.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
